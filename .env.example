APP_NAME="Learnify"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=learnify
DB_USERNAME=learnify_user
DB_PASSWORD=learnify_password

# Sessions, Cache & Queues
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=learnify_cache_

QUEUE_CONNECTION=redis

# Redis (Redis 7)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailpit dev)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@learnify.test"
MAIL_FROM_NAME="${APP_NAME}"

# Storage / Object Storage (MinIO)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=learnify_admin
AWS_SECRET_ACCESS_KEY=learnify_secret_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lms-public
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/lms-public

MINIO_ROOT_USER=learnify_admin
MINIO_ROOT_PASSWORD=learnify_secret_password
MINIO_BUCKET_PUBLIC=lms-public
MINIO_BUCKET_PRIVATE=lms-private
MINIO_BUCKET_VIDEOS=lms-videos

# Search (Meilisearch & Scout)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=learnify_meili_master_key

# WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=learnify_app
REVERB_APP_KEY=learnify_key
REVERB_APP_SECRET=learnify_secret
REVERB_HOST=localhost
REVERB_PORT=8085
REVERB_SCHEME=http

# Vite / Frontend
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Docker Port Mappings
APP_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MEILISEARCH_PORT=7700
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_REVERB_PORT=8085
FORWARD_VITE_PORT=5173
FORWARD_PHPMYADMIN_PORT=8081

# Pulse & Telescope
PULSE_ENABLED=true
TELESCOPE_ENABLED=true
